# Bu dosyayı sunucuda ".env" olarak kopyala ve değerleri doldur.
# `docker compose` bu klasördeki .env dosyasını otomatik okur.
#
#   cp .env.production.example .env

# Sunucunun dışarıdan erişilebilir adresi ve portu.
# Frontend build sırasında NEXT_PUBLIC_API_URL bu değerlerden üretilir,
# bu yüzden değiştirirsen frontend image'ını yeniden build etmen gerekir.
PUBLIC_HOST=178.105.207.98
PUBLIC_PORT=4003

# `openssl rand -base64 32` ile üret, başına "base64:" ekle.
# Örn: APP_KEY=base64:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX=
APP_KEY=

# MySQL
DB_DATABASE=hotel_reservation
DB_USERNAME=hotel_app
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-strong-root-password

# İlk deploy'da tabloları demo veriyle doldurmak için "true" yap,
# tablolar oluştuktan sonra tekrar "false"a çekip yeniden deploy et
# (yoksa her container restart'ında seeder tekrar çalışır).
DB_SEED_ON_BOOT=true

# Google ile giriş kullanılacaksa doldur, kullanılmayacaksa boş bırakılabilir.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
